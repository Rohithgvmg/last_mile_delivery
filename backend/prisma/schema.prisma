generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int                  @id @default(autoincrement())
  name          String
  email         String               @unique
  password      String
  role          Role                 @default(CUSTOMER)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  agent         Agent?
  orders        Order[]
  statusHistory OrderStatusHistory[]
}

model Agent {
  id          Int         @id @default(autoincrement())
  userId      Int         @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isAvailable Boolean     @default(false)
  latitude    Decimal?
  longitude   Decimal?
  user        User        @relation(fields: [userId], references: [id])
  zones       AgentZone[]
  orders      Order[]
}

model Zone {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  agents    AgentZone[]
  areas     Area[]
}

model Area {
  id           Int      @id @default(autoincrement())
  name         String
  zoneId       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  latitude     Decimal?
  longitude    Decimal?
  zone         Zone     @relation(fields: [zoneId], references: [id])
  dropOrders   Order[]  @relation("DropArea")
  pickupOrders Order[]  @relation("PickupArea")

  @@unique([zoneId, name])
}

model AgentZone {
  agentId Int
  zoneId  Int
  agent   Agent @relation(fields: [agentId], references: [id])
  zone    Zone  @relation(fields: [zoneId], references: [id])

  @@id([agentId, zoneId])
}

model RateCard {
  id           Int       @id @default(autoincrement())
  orderType    OrderType
  zoneType     ZoneType
  ratePerKg    Decimal
  codSurcharge Decimal
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([orderType, zoneType])
}

model Order {
  id               Int                  @id @default(autoincrement())
  userId           Int
  agentId          Int?
  pickupAreaId     Int
  dropAreaId       Int
  length           Decimal
  breadth          Decimal
  height           Decimal
  actualWeight     Decimal
  volumetricWeight Decimal
  chargeableWeight Decimal
  orderType        OrderType
  paymentType      PaymentType
  status           DeliveryStatus       @default(CREATED)
  ratePerKg        Decimal
  baseCharge       Decimal
  codSurcharge     Decimal
  totalCharge      Decimal
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  agent            Agent?               @relation(fields: [agentId], references: [id])
  dropArea         Area                 @relation("DropArea", fields: [dropAreaId], references: [id])
  pickupArea       Area                 @relation("PickupArea", fields: [pickupAreaId], references: [id])
  user             User                 @relation(fields: [userId], references: [id])
  statusHistory    OrderStatusHistory[]

  @@index([userId])
  @@index([agentId])
  @@index([pickupAreaId])
  @@index([dropAreaId])
  @@index([status])
}

model OrderStatusHistory {
  id        Int            @id @default(autoincrement())
  orderId   Int
  status    DeliveryStatus
  actorId   Int
  timestamp DateTime       @default(now())
  actor     User           @relation(fields: [actorId], references: [id])
  order     Order          @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([actorId])
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum OrderType {
  B2B
  B2C
}

enum ZoneType {
  INTRA
  INTER
}

enum PaymentType {
  PREPAID
  COD
}

enum DeliveryStatus {
  CREATED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}
